# Your Vatan API key. Create one at https://vatan.one/gateway/keys
# Give it a small budget and it cannot spend more than you decided.
VATAN_API_KEY=vk_live_...

# Optional. The default is the public gateway.
# VATAN_BASE_URL=https://gateway.vatan.one

# Optional. Any model id ending :batch that this workspace can use.
# VATAN_BATCH_MODEL=google/gemini-3.1-flash-lite:batch

# Only needed by receive_webhook.py: the signing secret of a webhook you have
# pointed at your own receiver. Create it at https://vatan.one/admin/webhooks
# and subscribe it to batch.finished.
# VATAN_WEBHOOK_SECRET=
